# The studio uses localhost by default and does not need API credentials.
STREAMER_GENERATOR_HOST=127.0.0.1
STREAMER_GENERATOR_PORT=8765
# Optional: path for temporary inputs and finished renders.
# STREAMER_GENERATOR_JOBS_DIR=C:/Users/you/.streamer-video-generator/jobs
# Optional: maximum size of each uploaded video in bytes (default 1.5 GB).
# STREAMER_GENERATOR_MAX_UPLOAD_BYTES=1500000000
